# API keys for the hike MCP servers.
# install.sh copies this file to <workspace>/.env (mode 600). Fill in the copy, never this file.
# Keys live only in the workspace .env: no MCP repo and no git repo holds them.
# hike-kit/bin/with-env.sh loads this file when Claude Code starts each server.

# refconv - Google Street View Static API (billed per image; the coverage check is free)
GOOGLE_MAPS_API_KEY=

# os-maps - Ordnance Survey Data Hub (OS Names API); optional server
OS_API_KEY=

# openroute - openrouteservice.org; optional server, not used by the skills
OPENROUTESERVICE_API_KEY=

# Leaders' micro-site (publishHikes skill): Amplify Hosting app, password protected
# Filled in by the one-off setup in skills/publishHikes/SKILL.md
HIKE_SITE_AMPLIFY_APP_ID=
HIKE_SITE_BRANCH=main
HIKE_SITE_USER=
HIKE_SITE_PASSWORD=
